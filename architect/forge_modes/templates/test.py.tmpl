"""Generated by `architect forge integrate`. Do not edit; see EVIDENCE.json.

These tests make no network calls. The license tests skip only where the license cannot
be checked at all (license_unverifiable: no Ed25519 seal, and no configured signing key
of the host that exported this package). A seal from a key this host does not trust, or
any other refusal, fails them. Keys count only where ARCHITECT_SIGNING_KEY_FILE or
ARCHITECT_TRUST_FILE names them, never a .architect folder on its own.

In CI, also run `architect verify --require-key <fingerprint> <this folder>` outside the
package: it accepts only that key's Ed25519 signature, so a copy stripped back to the
host-only HMAC (which would skip here) is refused.
"""
from __future__ import annotations

import asyncio
import hashlib
import importlib.util
import json
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[1]
CACHES = {"__pycache__", ".pytest_cache"}


def _package():
    name = ROOT.name
    module = sys.modules.get(name)
    if module is not None and Path(getattr(module, "__file__", "")).resolve().parent == ROOT:
        return module
    spec = importlib.util.spec_from_file_location(
        name, ROOT / "__init__.py", submodule_search_locations=[str(ROOT)]
    )
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def _artifact():
    from architect.spec import HarnessArtifact

    return HarnessArtifact.load(ROOT / "artifact")


def _needs_key():
    # Skip only when nothing here can check the license; key_untrusted and every other
    # refusal fail the license tests instead.
    check = _package().verify()
    if check.licensed is None and "license_unverifiable" in check.codes:
        pytest.skip("license_unverifiable_without_host_key")


def _run_with(model, tmp_path):
    from architect.forge_modes.shim import ExportedHarness
    from architect.models import FakeAdapter
    from architect.runtime import Runtime
    from architect.telemetry import TelemetryStore

    runtime = Runtime(TelemetryStore(tmp_path / "telemetry"))
    adapter = FakeAdapter(model="fake")
    adapter.model = model  # a fake adapter that claims another model
    try:
        harness = ExportedHarness(ROOT, _package().PIN)
        return asyncio.run(harness.run_with(runtime, adapter, {}))
    finally:
        runtime.store.close()


def test_manifest_integrity():
    from architect.forge_modes.export import cache_file_ok

    manifest = json.loads((ROOT / "MANIFEST.json").read_text(encoding="utf-8"))
    listed = {name: digest for name, digest in manifest["files"]}
    present = set()
    for path in ROOT.rglob("*"):
        relative = path.relative_to(ROOT)
        if not path.is_file():
            continue
        if CACHES & set(relative.parts):
            # A cache must be the compiled form of a listed source, never a substitute.
            assert cache_file_ok(ROOT, relative.as_posix(), listed), relative.as_posix()
            continue
        present.add(relative.as_posix())
    present.discard("MANIFEST.json")
    assert present == set(listed)
    for name, digest in listed.items():
        assert hashlib.sha256((ROOT / name).read_bytes()).hexdigest() == digest, name


def test_pins():
    pin = _package().PIN
    artifact = _artifact()
    assert artifact.artifact_digest == pin["artifact_digest"]
    assert artifact.spec.spec_hash == pin["spec_hash"]
    assert artifact.execution_mode == pin["execution_mode"]
    children = {}
    if artifact.forge is not None:
        children = {
            name: [ref.artifact_digest, ref.spec_hash, ref.case_origin]
            for name, ref in artifact.forge.subharnesses.items()
        }
    assert children == pin["children"]


def test_schema_hashes():
    from jsonschema import Draft202012Validator

    from architect.spec import schema_sha256

    spec = json.loads((ROOT / "artifact" / "spec.json").read_text(encoding="utf-8"))
    for side in ("input", "output"):
        schema = json.loads((ROOT / "schemas" / f"{side}.schema.json").read_text(encoding="utf-8"))
        assert schema_sha256(schema) == schema_sha256(spec[f"{side}_schema"])
        Draft202012Validator.check_schema(schema)
        Draft202012Validator.check_schema(spec[f"{side}_schema"])


def test_flag_default_off(monkeypatch):
    package = _package()
    monkeypatch.delenv(package.FLAG, raising=False)
    assert package.enabled() is False
    with pytest.raises(package.FeatureDisabled):
        asyncio.run(package.run({}, profile="unused.json", workspace="unused"))


def test_license_on_signing_host():
    _needs_key()
    assert _package().verify().licensed is True


def test_refuses_wrong_model(tmp_path):
    _needs_key()
    from architect.runtime import UnlicensedArtifactError

    with pytest.raises(UnlicensedArtifactError):
        _run_with("not-" + _artifact().model, tmp_path)


def test_fake_smoke(tmp_path):
    _needs_key()
    if _artifact().model != "fake":
        pytest.skip("live_model_required")
    output = _run_with("fake", tmp_path)
    json.dumps(output, allow_nan=False)
